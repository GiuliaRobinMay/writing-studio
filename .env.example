# Copy to `.env` for local dev, and set the same vars in Vercel → Settings →
# Environment Variables for production. None are required — the app runs without
# them (auth off, Claude in demo mode, brain in mock mode).

# ── Auth (Clerk) ──────────────────────────────────────────────────────────
# PUBLIC key (safe to expose). Turns on sign-in. Get it from the Clerk dashboard
# → API Keys → "Publishable key". Without it, the app runs open (no login).
VITE_CLERK_PUBLISHABLE_KEY=

# ── Claude (AI drafting) ──────────────────────────────────────────────────
# SECRET — set in Vercel only, never in the client. From console.anthropic.com.
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-4-8   # optional override

# ── BIG TRIBE BRAIN (BigQuery) ────────────────────────────────────────────
# SECRET — set in Vercel only. See server/README.md + DEPLOY.md.
# GCP_SA_KEY=                    # service-account key JSON
# BTB_BQ_PROJECT=
# BTB_BQ_DATASET=
